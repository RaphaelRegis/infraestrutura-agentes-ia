        <mxCell id="HhjtkQ-HEIg7WGbWzvYN-87" parent="1" style="whiteSpace=wrap;html=1;" value="Quebra resposta de acordo quebras de linha" vertex="1">
          <mxGeometry height="60" width="120" x="164" y="742" as="geometry" />
        </mxCell>
        <mxCell id="HhjtkQ-HEIg7WGbWzvYN-92" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=48;" value="AGENTES DE IA" vertex="1">
          <mxGeometry height="130" width="426" x="-750" y="-1230" as="geometry" />
        </mxCell>
        <mxCell id="HhjtkQ-HEIg7WGbWzvYN-94" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;01 - Função Lambda&lt;/h1&gt;&lt;p&gt;Recebe a mensagem e faz a triagem.&lt;/p&gt;&lt;p&gt;Normaliza o corpo da mensagem de acordo com a origem da mensagem (podem ser diferentes aplicações — WhatsApp, Telegram — ou mecanismos, como a Uazapi).&lt;/p&gt;&lt;p&gt;Normaliza também a situação da conversa, criando-a caso não exista e verificando se está pausada.&lt;/p&gt;&lt;p&gt;Por fim, envia o resultado final para o MESSAGE ADAPTER.&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="340" x="360" y="-838" as="geometry" />
        </mxCell>
        <mxCell id="HhjtkQ-HEIg7WGbWzvYN-96" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;02 - Message Adapter&lt;br&gt;&lt;/h1&gt;&lt;div&gt;Recebe mensagens e transforma mensagens de áudio e imagem em texto.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Caso a conversa esteja pausada, ele apenas salva a mensagem no banco de dados. Caso contrário, ele manda a mensagem para o DEBOUNCER.&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="340" x="40" y="-450" as="geometry" />
        </mxCell>
        <mxCell id="HhjtkQ-HEIg7WGbWzvYN-97" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;03 - Debouncer&lt;br&gt;&lt;/h1&gt;&lt;div&gt;Transforma mensagens de uma mesma conversa que chegam muito rapidamente numa mensagem só para a IA processar.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Com a mensagem pronta, ele manda a mensagem para a IA.&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="340" x="700" y="-48" as="geometry" />
        </mxCell>
        <mxCell id="HhjtkQ-HEIg7WGbWzvYN-101" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;04 - IA&lt;br&gt;&lt;/h1&gt;&lt;div&gt;Processa a mensagem do cliente e prepara uma resposta.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Utiliza diversas tools que acumulam suas chamadas num cache para que possam ser registradas num banco de dados.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Também faz a quebra das mensagens e prepara mensagens de follow-up caso necessário.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Por fim, joga as mensagens no RabbitMQ nas respectivas filas.&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="340" x="500" y="645" as="geometry" />
        </mxCell>
        <mxCell id="HhjtkQ-HEIg7WGbWzvYN-102" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;05 - Disparador de mensagens&lt;br&gt;&lt;/h1&gt;&lt;div&gt;Envia as mensagens de acordo com o aplicativo/mecanismo de mensagens.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Não é usado só aqui, mas descreveremos apenas a regra plausível nesse caso (respostas da IA).&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Ele detecta o evento no RabbitMQ que contém as mensagens a serem enviadas e então as envia com um intervalo de 2 a 4 segundos entre elas.&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="370" x="-20" y="1060" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
